{
  "name": "sitewatch-desktop",
  "productName": "SiteWatch",
  "version": "0.1.0",
  "description": "Desktop app that watches login-protected web pages and alerts you when they change or go in stock",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.sitewatch",
    "productName": "SiteWatch",
    "publish": null,
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*"],
    "mac": { "category": "public.app-category.utilities", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"] }
  }
}
